<footer class="site-footer">
  <div class="footer-grid">
    <form class="newsletter" name="newsletter" method="POST" action="/thanks/?form=newsletter" data-netlify="true" netlify-honeypot="company">
      <input type="hidden" name="form-name" value="newsletter">
      <p class="hp"><label>Leave empty <input name="company" tabindex="-1" autocomplete="off"></label></p>
      <label class="newsletter-label" for="newsletter-email">New work and exhibitions, by email</label>
      <div class="newsletter-row">
        <input id="newsletter-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com">
        <button type="submit" class="btn btn-quiet">Sign up</button>
      </div>
      <p class="fine">A few emails a year. Unsubscribe any time. See the <a href="/privacy/">privacy policy</a>.</p>
    </form>

    <nav class="footer-links" aria-label="Footer">
      <ul>
        <li><a href="/shipping-returns/">Shipping and returns</a></li>
        <li><a href="/terms/">Terms of sale</a></li>
        <li><a href="/privacy/">Privacy policy</a></li>
        {%- if site.prints.enabled %}<li><a href="/prints/">Prints</a></li>{% endif %}
      </ul>
      <ul>
        {%- for s in site.social %}
        <li><a href="{{ s.url }}" rel="me noopener">{{ s.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
  <p class="copyright">© {{ "" | year }} Paints by Euro. All artwork is the property of the artist.</p>
</footer>
