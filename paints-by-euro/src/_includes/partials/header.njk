{%- set nav = [
  { url: "/work/", label: "Work" },
  { url: "/about/", label: "About" },
  { url: "/process/", label: "Process" },
  { url: "/contact/", label: "Contact" }
] %}
<header class="site-header">
  <a class="wordmark" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>{{ site.name }}</a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    <span class="menu-toggle-open">Menu</span><span class="menu-toggle-close">Close</span>
  </button>
  <nav id="site-nav" class="site-nav" aria-label="Main">
    <ul>
      {%- for item in nav %}
      <li><a href="{{ item.url }}"{% if (page.url or "").startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
    </ul>
  </nav>
</header>
