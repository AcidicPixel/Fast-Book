---
layout: layouts/base.njk
bodyClass: page-home
description: "Original oil paintings and pen sketches, prints, cards and postcards. Browse the collections, join the monthly Print Club or start a commission."
---
{%- set featured = null %}
{%- for w in collections.works %}{% if w.data.featured and not featured %}{% set featured = w %}{% endif %}{% endfor %}
{%- if not featured %}{% set featured = collections.works[0] %}{% endif %}
{%- set f = featured.data %}
<h1 class="visually-hidden">{{ site.name }}: oil paintings, pen sketches, prints and cards</h1>

{#- 1. Hero: featured work (7 of 12 columns) + introduction #}
<section class="home-hero" aria-label="Featured work and introduction">
  <figure class="hero-figure" data-work="{{ featured.fileSlug }}">
    <a href="{{ featured.url }}" aria-label="{{ f.title }}: details">
      {% picture f.image, f | altText, "large", "(min-width: 64em) 56vw, 100vw", "", true %}
    </a>
    <figcaption class="hero-caption"><span class="t">{{ f.title }}</span> <span>{{ f.medium | mediumLabel }}, {{ f.year }}</span></figcaption>
  </figure>
  <div class="hero-text">
    <p class="hero-intro">{{ site.intro }}</p>
    <p class="hero-tagline">{{ site.tagline }}</p>
    <a class="text-link" href="/collections/">View the collections →</a>
  </div>
</section>

{#- 2. The Collections: one tile per medium #}
{%- set tileImages = {
  oil: "/images/works/oil-05/placeholder-oil-05-main.jpg",
  pen: "/images/works/pen-02/placeholder-pen-02-main.jpg",
  print: "/images/products/placeholder-print-oil-01.jpg",
  card: "/images/products/placeholder-card-oil-03.jpg"
} %}
<section class="home-section" aria-labelledby="collections-title">
  <div class="section-head">
    <h2 id="collections-title" class="section-title" data-reveal-text>The Collections</h2>
    <a class="line-link" href="/collections/">All collections</a>
  </div>
  <ul class="tiles" role="list">
    {%- for m in mediums %}
    <li data-reveal-scope>
      <a class="tile" href="/collections/?medium={{ m.key }}">
        <span class="tile-frame" data-reveal>{% picture tileImages[m.key], "Placeholder: " + m.name, "thumb", "(min-width: 64em) 22vw, 46vw" %}</span>
        <span class="tile-name" data-reveal-line>{{ m.name }}</span>
      </a>
    </li>
    {%- endfor %}
  </ul>
</section>

{#- 3. Print Club #}
<section class="home-section club-panel" aria-labelledby="club-title">
  <figure class="club-photo" data-reveal>
    {% picture "/images/print-club/placeholder-bundle-01.jpg", "Placeholder: a Print Club bundle with a print, a card and a postcard", "large", "(min-width: 64em) 50vw, 100vw" %}
  </figure>
  <div class="club-text">
    <h2 id="club-title" class="section-title" data-reveal-text>Print Club</h2>
    <p data-reveal-text>Every month, a small bundle of new art arrives at your door: one print, one card and one postcard, for {{ site.printClub.price }} a month. Skip a month or cancel whenever you like.</p>
    <a class="btn btn-solid" href="/print-club/">Join the Print Club →</a>
  </div>
</section>

{#- 4. Commissions #}
<section class="home-section commission-line" aria-labelledby="commission-title">
  <h2 id="commission-title" class="visually-hidden">Commissions</h2>
  <p class="commission-text" data-reveal-text>I take commissions in oil paint and pen: a place, a person or a view that matters to you.</p>
  <a class="text-link" href="/commission-contact/?subject=Commission">Start a commission →</a>
</section>

{#- 5. Exhibitions and news: only when there is an upcoming event #}
{%- set upcoming = site.events | upcoming %}
{%- if upcoming.length %}
{%- set ev = upcoming[0] %}
<section class="home-section event" aria-labelledby="event-title">
  <h2 id="event-title" class="section-title" data-reveal-text>Exhibitions and news</h2>
  <p class="event-line" data-reveal-text><strong>{{ ev.name }}</strong> · {{ ev.dateText or ev.date }} · {{ ev.place }}</p>
  {%- if ev.url %}<a class="line-link" href="{{ ev.url }}">Details</a>{% endif %}
</section>
{%- endif %}

{#- 6. Newsletter #}
<section class="home-section home-newsletter" aria-labelledby="newsletter-title">
  <form class="newsletter" name="newsletter" method="POST" action="/api/newsletter">
    <p class="hp"><label>Leave empty <input name="company" tabindex="-1" autocomplete="off"></label></p>
    <h2 id="newsletter-title" class="section-title">Newsletter</h2>
    <label class="newsletter-label" for="home-newsletter-email">New pieces, Print Club news and exhibitions, by email</label>
    <div class="newsletter-row">
      <input id="home-newsletter-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com">
      <button type="submit" class="btn btn-quiet">Sign up</button>
    </div>
    <p class="fine">A few emails a year. Unsubscribe any time. See the <a class="line-link" href="/privacy/">privacy policy</a>.</p>
  </form>
</section>
