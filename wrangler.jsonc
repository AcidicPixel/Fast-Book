{
  // Cloudflare Workers settings for Paints by Euro.
  // Pages (HTML, images, CSS) are served from _site; only /api/* runs the Worker code.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paints-by-euro",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // The database for live Reserved/Sold status, Print Club members and form entries.
  "d1_databases": [
    { "binding": "DB", "database_name": "paints-by-euro" }
  ],
  // Once a day: wake PayPal Print Club members after a skipped month.
  "triggers": { "crons": ["0 10 * * *"] },
  // Keep the variables you add in the dashboard when the site is redeployed.
  "keep_vars": true,
  "observability": { "enabled": true },
  // Settings for preview builds ("npx wrangler preview"). Previews don't run the daily cron.
  "previews": {}
}
